// -*- mode:c++ -*-
// SPDX-License-Identifier: BSD-3-Clause

def template DasicsCallJRConstructor {{
    %(class_name)s::%(class_name)s(ExtMachInst machInst)
        : %(base_class)s("%(mnemonic)s", machInst, %(op_class)s)
    {
        %(set_reg_idx_arr)s;
        %(constructor)s;
        imm = sext<12>(IMM12);

        // Apply JALR register hints independently of the custom opcode.
        const bool rd_link = RD == 1 || RD == 5;
        const bool rs1_link = RS1 == 1 || RS1 == 5;
        flags[IsCall] = rd_link;
        flags[IsReturn] = rs1_link && (!rd_link || RD != RS1);
    }
}};

def template DasicsCallExecute {{
    Fault
    %(class_name)s::execute(
        ExecContext *xc, trace::InstRecord *traceData) const
    {
        %(op_decl)s;
        %(op_rd)s;

        auto *isa = static_cast<RiscvISA::ISA *>(xc->tcBase()->getIsaPtr());
        Fault fault = dasicsTrustedDomainAccessCheck(
            xc, machInst, isa->getDasicsVAddrBits());
        if (fault != NoFault) {
            return fault;
        }

        %(code)s;

        // ExecContext defers this write until O3 commit. Serialize-after keeps
        // younger instructions from executing with an old ReturnPC.
        xc->setMiscReg(MISCREG_DASICS_RETURN_PC, PC + 4);
        %(op_wb)s;
        return NoFault;
    }
}};

def template DasicsCallJMethods {{
    std::unique_ptr<PCStateBase>
    %(class_name)s::branchTarget(const PCStateBase &branch_pc) const
    {
        auto &rpc = branch_pc.as<RiscvISA::PCState>();
        std::unique_ptr<PCState> npc(dynamic_cast<PCState *>(rpc.clone()));
        npc->set(rvSext(rpc.pc() + imm));
        return npc;
    }

    std::string
    %(class_name)s::generateDisassembly(
            Addr pc, const loader::SymbolTable *symtab) const
    {
        std::stringstream ss;
        ss << mnemonic << ' ' << registerName(destRegIdx(0)) << ", " << imm;
        return ss.str();
    }
}};

def template DasicsCallJRMethods {{
    std::unique_ptr<PCStateBase>
    %(class_name)s::branchTarget(ThreadContext *tc) const
    {
        PCStateBase *pc_ptr = tc->pcState().clone();
        // The operand table represents x0 with an invalid register ID.
        const RegVal base = RS1 == 0 ? 0 : tc->getReg(srcRegIdx(0));
        pc_ptr->as<PCState>().set(rvSext((base + imm) & ~0x1));
        return std::unique_ptr<PCStateBase>{pc_ptr};
    }

    std::string
    %(class_name)s::generateDisassembly(
            Addr pc, const loader::SymbolTable *symtab) const
    {
        std::stringstream ss;
        ss << mnemonic << ' ' << registerName(destRegIdx(0)) << ", "
           << imm << "(" << registerName(srcRegIdx(0)) << ")";
        return ss.str();
    }
}};

def format DasicsCallJ(code, *opt_flags) {{
    imm_code = """
        // This format uses the encoded RD bits as part of the displacement.
        imm = DIJIMMBITS10TO1  << 1  |
              DIJIMMBITS14TO11 << 11 |
              DIJIMMBITS20TO15 << 15 |
              DIJIMMBIT21      << 21 |
              IMMSIGN         << 22;
        imm = sext<23>(imm);
    """
    iop = InstObjParams(name, Name, 'ImmOp<int64_t>',
        {'code': code, 'imm_code': imm_code}, opt_flags)
    header_output = BranchDeclare.subst(iop)
    decoder_output = ImmConstructor.subst(iop)
    decode_block = BasicDecode.subst(iop)
    exec_output = DasicsCallExecute.subst(iop) + DasicsCallJMethods.subst(iop)
}};

def format DasicsCallJR(code, *opt_flags) {{
    iop = InstObjParams(name, Name, 'ImmOp<int64_t>', code, opt_flags)
    header_output = JumpDeclare.subst(iop)
    decoder_output = DasicsCallJRConstructor.subst(iop)
    decode_block = BasicDecode.subst(iop)
    exec_output = DasicsCallExecute.subst(iop) + DasicsCallJRMethods.subst(iop)
}};

def template DasicsTrustedRenameAccess {{
    Fault
    %(class_name)s::checkRenameAccess(ExecContext *xc) const
    {
        auto *isa = static_cast<RiscvISA::ISA *>(xc->tcBase()->getIsaPtr());
        return dasicsTrustedDomainAccessCheck(
            xc, machInst, isa->getDasicsVAddrBits());
    }
}};

def template DasicsProregIDeclare {{
    class %(class_name)s : public %(base_class)s
    {
      private:
        %(reg_idx_arr_decl)s;

      public:
        %(class_name)s(ExtMachInst machInst);
        std::optional<RegProtectionRequest> regProtectionRequest()
            const override;
        Fault regProtectionConflictFault() const override;
        Fault checkRenameAccess(ExecContext *xc) const override;
        Fault execute(ExecContext *xc, trace::InstRecord *traceData)
            const override;
        std::string generateDisassembly(Addr pc,
            const loader::SymbolTable *symtab) const override;
    };
}};

def template DasicsProregIMethods {{
    std::optional<StaticInst::RegProtectionRequest>
    %(class_name)s::regProtectionRequest() const
    {
        // The two saved ranges skip argument registers 10-17 in both classes.
        const uint32_t low = bits(imm, 1, 0);
        const uint32_t high = bits(imm, 11, 2);
        const uint32_t mask = (low << %(saved0)s.index()) |
                              (high << %(saved2)s.index());
        return RegProtectionRequest{%(reg_class)s, mask};
    }

    Fault
    %(class_name)s::regProtectionConflictFault() const
    {
        return std::make_shared<IllegalInstFault>(
            "%(conflict_reason)s", machInst);
    }

    Fault
    %(class_name)s::execute(ExecContext *xc,
        trace::InstRecord *traceData) const
    {
        // O3 carries any access fault from Rename to Commit.
        return NoFault;
    }

    std::string
    %(class_name)s::generateDisassembly(
            Addr pc, const loader::SymbolTable *symtab) const
    {
        return csprintf("%s 0x%03x", mnemonic, imm);
    }
}};

def format DasicsProregI(reg_class, *opt_flags) {{
    # The selector occupies the usual rd bits; it is not a register operand.
    mnemonic = name.replace("_", ".")
    iop = InstObjParams(mnemonic, Name, "ImmOp<uint16_t>",
        {"imm_code": "imm = IMM12;"}, opt_flags)
    iop.reg_class = reg_class
    iop.saved0, iop.saved2, slot_kind = {
        "IntRegClass": ("int_reg::S0", "int_reg::S2", "integer"),
        "FloatRegClass": ("float_reg::Fs0", "float_reg::Fs2",
                          "floating-point"),
    }[reg_class]
    iop.conflict_reason = (f"{mnemonic.upper()} requires all {slot_kind} "
                           "restore slots to be empty")
    header_output = DasicsProregIDeclare.subst(iop)
    decoder_output = ImmConstructor.subst(iop)
    decode_block = BasicDecode.subst(iop)
    exec_output = (DasicsTrustedRenameAccess.subst(iop) +
                   DasicsProregIMethods.subst(iop))
}};

def template DasicsLeaveDeclare {{
    class %(class_name)s : public %(base_class)s
    {
      private:
        %(reg_idx_arr_decl)s;

      public:
        %(class_name)s(ExtMachInst machInst);
        bool restoresProtectedRegs() const override { return true; }
        Fault checkRenameAccess(ExecContext *xc) const override;
        Fault execute(ExecContext *xc, trace::InstRecord *traceData)
            const override;
        using %(base_class)s::generateDisassembly;
    };
}};

def format DasicsLeave(code, *opt_flags) {{
    iop = InstObjParams(name, Name, 'SystemOp', code, opt_flags)
    header_output = DasicsLeaveDeclare.subst(iop)
    decoder_output = BasicConstructor.subst(iop)
    decode_block = BasicDecode.subst(iop)
    exec_output = (DasicsTrustedRenameAccess.subst(iop) +
                   BasicExecute.subst(iop))
}};
