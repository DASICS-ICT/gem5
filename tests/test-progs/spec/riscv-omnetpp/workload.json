{
    "benchmark": "471.omnetpp",
    "sizes": {
        "test": {
            "runs": [
                {
                    "argv": [
                        "omnetpp.ini"
                    ],
                    "stdout": "omnetpp.log",
                    "stderr": "omnetpp.err"
                }
            ],
            "comparisons": [
                {
