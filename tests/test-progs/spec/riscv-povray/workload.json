            "runs": [
                {
                    "argv": [
                        "SPEC-benchmark-test.ini"
                    ],
                    "stdout": "SPEC-benchmark-test.stdout",
                    "stderr": "SPEC-benchmark-test.stderr"
                }
            ],
            "comparisons": [
                {
                    "run": 1,
                    "file": "SPEC-benchmark.log",
                    "args": [
                        "--abstol",
                        "0",
                        "--reltol",
                        "0.0002"
                    ]
                },
                {
