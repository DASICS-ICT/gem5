$(DST_DIR)/src/globalvar.o: src/globalvar.f90 $(DST_DIR)/src/parameter.o
$(DST_DIR)/src/posvector.o: src/posvector.f90 $(DST_DIR)/src/parameter.o
$(DST_DIR)/src/huygens.fppized.o: src/huygens.fppized.f90 $(addprefix $(DST_DIR)/src/, parameter.o globalvar.o excite.o errorcheck.o)
$(DST_DIR)/src/UPML.fppized.o: src/UPML.fppized.f90 $(addprefix $(DST_DIR)/src/, parameter.o globalvar.o errorcheck.o PEC.o)
$(DST_DIR)/src/NFT.fppized.o: src/NFT.fppized.f90 $(addprefix $(DST_DIR)/src/, parameter.o globalvar.o posvector.o fourier_transf.o errorcheck.o excite.o huygens.fppized.o)
