$(DST_DIR)/src/excite.o: src/excite.f90 $(addprefix $(DST_DIR)/src/, parameter.o globalvar.o)
$(DST_DIR)/src/PEC.o: src/PEC.f90 $(addprefix $(DST_DIR)/src/, parameter.o errorcheck.o readline.o globalvar.o)
$(DST_DIR)/src/progress.o: src/progress.f90 $(addprefix $(DST_DIR)/src/, parameter.o globalvar.o)
$(DST_DIR)/src/calcflops.o: src/calcflops.f90 $(addprefix $(DST_DIR)/src/, globalvar.o parameter.o  huygens.fppized.o UPML.fppized.o NFT.fppized.o)
