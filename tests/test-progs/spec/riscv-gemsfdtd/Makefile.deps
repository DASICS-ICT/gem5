$(DST_DIR)/src/leapfrog.o: src/leapfrog.f90 $(addprefix $(DST_DIR)/src/, errorcheck.o parameter.o PEC.o calcflops.o globalvar.o progress.o huygens.fppized.o update.fppized.o UPML.fppized.o NFT.fppized.o)
