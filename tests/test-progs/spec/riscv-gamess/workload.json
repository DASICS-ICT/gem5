                        "--abstol",
                        "1e-5",
                        "--reltol",
                        "0.0001",
                        "--ignorecase"
                    ]
                },
                {
                    "run": 2,
                    "file": "h2ocu2+.gradient.out",
                    "args": [
                        "--abstol",
                        "1e-5",
                        "--reltol",
                        "0.0001",
                        "--ignorecase"
                    ]
                },
                {
                    "run": 3,
                    "file": "triazolium.out",
                    "args": [
                        "--abstol",
